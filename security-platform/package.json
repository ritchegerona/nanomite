{
  "name": "security-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/backend/*",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=backend...",
    "build:frontend": "turbo run build --filter=frontend",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml,rs,toml}\"",
    "db:migrate": "cd packages/backend/core && sqlx migrate run",
    "db:reset": "cd packages/backend/core && sqlx database reset",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down -v",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "rust": ">=1.78.0"
  },
  "packageManager": "npm@10.8.0"
}