{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "target/**", "build/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {},
    "db:reset": {}
  },
  "globalDependencies": [".env*"],
  "globalEnv": ["DATABASE_URL", "REDIS_URL", "MINIO_ENDPOINT", "NANOMITE_PATH"]
}